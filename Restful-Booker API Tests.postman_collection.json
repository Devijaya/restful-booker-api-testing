      "name": "08 - Negative: Get Non-Existent Booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Non-existent ID returns 404 Not Found\", function () {\r\n    pm.response.to.have.status(404);\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
