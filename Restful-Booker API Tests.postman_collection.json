{
  "info": {
    "_postman_id": "96a30bdd-d21b-4f0a-8b60-46e697c24ad1",
    "name": "Restful-Booker API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "60419812",
