  },
  "item": [
    {
      "name": "01 - Create Auth Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Test 1: Check the status code\r\npm.test(\"Status code is 200 OK\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\n// Test 2: Check the response time\r\npm.test(\"Response time is acceptable (< 3000ms)\", function () {\r\n    pm.expect(pm.response.responseTime).to.be.below(3000);\r\n});\r\n\r\n// Test 3: Check and save the token\r\npm.test(\"Auth token generated and saved\", function () {\r\n    var jsonData = pm.response.json();\r\n\r\n    pm.expect(jsonData).to.have.property(\"token\");\r\n    pm.expect(jsonData.token).to.be.a(\"string\").and.not.be.empty;\r\n\r\n    pm.environment.set(\"token\", jsonData.token);\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"username\": \"admin\",\r\n    \"password\": \"password123\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/auth",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth"
          ]
        }
      },
      "response": []
    },
    {
      "name": "02 - Create Booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Booking created with accurate guest details\", function () {\r\n    var jsonData = pm.response.json();\r\n\r\n    pm.expect(jsonData).to.have.property(\"bookingid\");\r\n    pm.expect(jsonData.booking.firstname).to.eql(\"Kasun\");\r\n    pm.expect(jsonData.booking.lastname).to.eql(\"Perera\");\r\n    pm.expect(jsonData.booking.totalprice).to.eql(150);\r\n\r\n    pm.environment.set(\"booking_id\", jsonData.bookingid);\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"firstname\": \"Kasun\",\r\n    \"lastname\": \"Perera\",\r\n    \"totalprice\": 150,\r\n    \"depositpaid\": true,\r\n    \"bookingdates\": {\r\n        \"checkin\": \"2026-12-01\",\r\n        \"checkout\": \"2026-12-05\"\r\n    },\r\n    \"additionalneeds\": \"Breakfast\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/booking",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "booking"
          ]
        }
      },
      "response": []
    },
    {
      "name": "03 - Get Booking by ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Fetched booking matches created record\", function () {\r\n    var jsonData = pm.response.json();\r\n\r\n    pm.expect(jsonData.firstname).to.eql(\"Kasun\");\r\n    pm.expect(jsonData.lastname).to.eql(\"Perera\");\r\n    pm.expect(jsonData.depositpaid).to.be.true;\r\n    pm.expect(jsonData.additionalneeds).to.eql(\"Breakfast\");\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/booking/{{booking_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "booking",
            "{{booking_id}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "04 - Update Booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Booking price and additional needs updated\", function () {\r\n    var jsonData = pm.response.json();\r\n\r\n    pm.expect(jsonData.totalprice).to.eql(250);\r\n    pm.expect(jsonData.additionalneeds).to.eql(\"Airport Pickup\");\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "token={{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"firstname\": \"Kasun\",\r\n    \"lastname\": \"Perera\",\r\n    \"totalprice\": 250,\r\n    \"depositpaid\": true,\r\n    \"bookingdates\": {\r\n        \"checkin\": \"2026-12-01\",\r\n        \"checkout\": \"2026-12-05\"\r\n    },\r\n    \"additionalneeds\": \"Airport Pickup\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/booking/{{booking_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "booking",
            "{{booking_id}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "05 - Delete Booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201 (Deleted successfully)\", function () {\r\n    pm.response.to.have.status(201);\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "token={{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/booking/{{booking_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "booking",
            "{{booking_id}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "06 - Negative: Invalid Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"API rejects invalid credentials with Bad credentials message\", function () {\r\n    var jsonData = pm.response.json();\r\n\r\n    pm.expect(jsonData).to.not.have.property(\"token\");\r\n    pm.expect(jsonData.reason).to.eql(\"Bad credentials\");\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"username\": \"admin\",\r\n    \"password\": \"wrong_password_123\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/auth?Content-Type=application/json",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth"
          ],
          "query": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "07 - Negative: Update Without Auth Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Unauthorized update is blocked with 403 Forbidden\", function () {\r\n    pm.response.to.have.status(403);\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"firstname\": \"Hacker\",\r\n    \"lastname\": \"Test\",\r\n    \"totalprice\": 1,\r\n    \"depositpaid\": false,\r\n    \"bookingdates\": {\r\n        \"checkin\": \"2026-12-01\",\r\n        \"checkout\": \"2026-12-02\"\r\n    }\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/booking/{{booking_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "booking",
            "{{booking_id}}"
          ]
        }
      },
      "response": []
